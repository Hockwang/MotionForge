# MotionForge 环境变量模板
# 使用：cp .env.example .env，然后填入真实值
# .env 已在 .gitignore，不会被提交

# ── AI 后端（tools/conversion-service.js）──
# 使用的 AI 服务地址；默认 https://coding.qunhequnhe.com（群核 LLM 网关）
AI_BASE_URL=https://coding.qunhequnhe.com

# AI API key（必填；为空时后端返回 500）
AI_API_KEY=your_api_key_here

# 使用的模型 id；默认 gemini-3-flash-thinking
AI_MODEL=gemini-3-flash-thinking

# converter 端口；默认 8091（前端 AI_SERVICE_URL 要和它对上）
# CONVERTER_PORT=8091

# CORS 白名单（逗号分隔）；默认只允许本地前端
# CORS_ALLOW=http://localhost:5173,http://localhost:4173

# AI 接口速率限制（每分钟次数）；默认 30
# AI_RATE_LIMIT_PER_MIN=30

# ── Blender USD/FBX 转换（可选）──
# 本地 Blender 可执行文件路径；默认 C:\Program Files\Blender Foundation\Blender 5.1\blender.exe
# Linux/Mac 用户请改为实际路径（如 /usr/bin/blender）
# BLENDER_PATH=C:\Program Files\Blender Foundation\Blender 5.1\blender.exe
